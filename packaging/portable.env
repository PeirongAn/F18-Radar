# F18 Radar portable runtime defaults.
# Adjust device-specific paths on the target machine if needed.
LOG_LEVEL=INFO
LOG_TO_FILE=true
PHYSIO_SAMPLE_STORAGE=file
EXTERNAL_COLLECTORS_ENABLED=false

# Example for vendor CSV collection:
# PHYSIO_SOURCE=vendor_csv
# PHYSIO_VENDOR_ROOT=D:\hengzhi\data

# Disable embedded physio collection if this machine has no ring/wristband:
# PHYSIO_RING_ENABLED=false
