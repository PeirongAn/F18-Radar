# Server logging
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Tobii gaze reminder
GAZE_OUT_OF_BOX_FALSE_THRESHOLD=200
GAZE_PROGRESS_LOGS=false
GAZE_SCREEN_WIDTH=2560
GAZE_SCREEN_HEIGHT=1440

# Built-in physio recorder
PHYSIO_RING_ENABLED=false

# External physiological collectors
EXTERNAL_COLLECTORS_ENABLED=true
EXTERNAL_COLLECTORS=wecare,prime
EXTERNAL_COLLECTORS_DB_PATH=server/data/external_collectors/collector_records.sqlite3

# Whether to call the Wecare S2 collector service.
WECARE_COLLECTOR_ENABLED=true
WECARE_COLLECTOR_BASE_URL=http://127.0.0.1:8787
WECARE_COLLECTOR_PROVIDER=wecare

# Whether to call the Prime MQTT collector service.
PRIME_COLLECTOR_ENABLED=false
PRIME_COLLECTOR_BASE_URL=http://127.0.0.1:8789
PRIME_COLLECTOR_PROVIDER=prime
PRIME_COLLECTOR_MARKER_TYPE=1
